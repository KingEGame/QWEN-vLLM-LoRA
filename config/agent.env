# Local personal-agent runtime. Do not place credentials in this file.
AGENT_MODEL=personal-agent
AGENT_BASE_MODEL=Qwen/Qwen3.5-2B
AGENT_FALLBACK_MODEL=Qwen/Qwen3.5-2B
AGENT_TEACHER_MODEL=unsloth/Qwen3.8-27B-NVFP4
AGENT_PORT=8000
AGENT_MAX_STEPS=12
AGENT_MEMORY_MAX_CHARS=3000
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_AUTO_RESUME=1
AGENT_WORKSPACE=.
AGENT_TASK_LEDGER=output/agent/tasks.json
AGENT_RUNTIME_MEMORY=output/agent/memory.jsonl
AGENT_RUN_LOG=output/agent/runs.jsonl
AGENT_ADAPTER_OUTPUT=output/lora_phone_qwen3_5_2b
AGENT_MERGED_OUTPUT=output/personal_phone_qwen3_5_2b_merged
AGENT_GGUF_OUTPUT=output/personal-phone-qwen3.5-2b-q4_k_m.gguf
AGENT_TRAIN_DATA=data/personal/agent_train.jsonl
AGENT_MIN_TRAIN_EXAMPLES=20
AGENT_INCLUDE_TEACHER_CURATED=1
AGENT_TOOL_MODE=read-only
AGENT_TASK_SYNC_PROVIDER=local

# Edge export targets. Q4_K_M is a starting point; benchmark on each device.
EDGE_RUNTIME=llama.cpp
EDGE_QUANTIZATION=Q4_K_M
EDGE_CONTEXT=4096
LLAMA_CPP_DIR=qwen_personal_assistant/external/llama.cpp
