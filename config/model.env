MODEL=unsloth/Qwen3.8-27B-NVFP4
PORT=8000
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.94
MAX_NUM_SEQS=1
QUANTIZATION=none
ADAPTER_NAME=support-adapter
REASONING_PARSER=qwen3
LANGUAGE_MODEL_ONLY=1
EXTRA_ARGS="--kv-cache-dtype fp8 --kv-cache-memory-bytes 512M --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_coder"
TRAIN_MODEL=Qwen/Qwen3.8-27B
# QLoRA quality / resource knobs (~70% of free GPU + CPU workers)
TRAIN_MAX_SEQ_LENGTH=1024
TRAIN_BATCH_SIZE=2
TRAIN_NUM_EPOCHS=3
TRAIN_GRAD_ACCUM=8
TRAIN_RESOURCE_FRACTION=0.70
TRAIN_GRADIENT_CHECKPOINTING=0
