# Adjusted for a 6GB VRAM GPU (RTX 3060 Laptop) running under WSL2.
# The base bf16 Qwen3-4B (~8GB weights) does NOT fit in 6GB, so we use a
# 4-bit checkpoint. Original 8GB-tier defaults are kept as comments.
#
# NOTE: keep comments on their OWN lines. The Python config loader
# (scripts/lib/env_config.py) does not strip trailing "# ..." comments the way
# bash `source` does, so an inline comment would leak into values like MODEL.

# bf16, needs ~8GB+ VRAM:
# MODEL=Qwen/Qwen3-4B-Instruct-2507
# 4-bit (compressed-tensors W4A16), ~3.3GB weights:
MODEL=warshanks/Qwen3-4B-Instruct-2507-AWQ
PORT=8000
# full 32768 context makes the KV cache too big for 6GB; trimmed to 4096:
# MAX_MODEL_LEN=32768
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.97
# This checkpoint is 4-bit compressed-tensors (W4A16), not classic AWQ, so we do
# NOT force a quantization flag -- vLLM auto-detects it from the model config.
QUANTIZATION=none
ADAPTER_NAME=support-adapter
# --enforce-eager disables CUDA-graph capture + torch.compile, which frees ~1-2GB
# of VRAM (essential on this 6GB card) and speeds up startup.
# --max-num-batched-tokens/--max-num-seqs shrink the prefill activation peak that
# vLLM reserves during memory profiling, leaving room for KV cache on 6GB.
EXTRA_ARGS="--enforce-eager --max-num-batched-tokens 512 --max-num-seqs 2"
